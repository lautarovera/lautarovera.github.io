---
import BaseLayout from './BaseLayout.astro';
import { isoDate } from '../lib/content';
import type { BlockId } from '../lib/floorplan';

interface Props {
	title: string;
	description: string;
	date: Date;
	updated?: Date;
	tags: string[];
	lang: 'en' | 'es';
	draft: boolean;
	block: BlockId;
	cover?: { src: string; alt: string };
	/** Position on the die, e.g. "FW-03". */
	position?: string;
}

const { title, description, date, updated, tags, lang, draft, block, cover, position } =
	Astro.props;
---

<BaseLayout title={title} description={description} lang={lang} ogType="article" die={block}>
	<article>
		{
			cover && (
				<figure class="cover">
					<img src={cover.src} alt={cover.alt} width="1200" height="630" />
				</figure>
			)
		}
		<header class:list={['article-header', { 'has-cover': cover }]}>
			{draft && <p class="draft mono">DRAFT — not in production build</p>}
			<h1>{title}</h1>
			<p class="lede">{description}</p>
			<dl class="meta mono">
				<div>
					<dt>Published</dt>
					<dd><time datetime={date.toISOString()}>{isoDate(date)}</time></dd>
				</div>
				{
					updated && (
						<div>
							<dt>Updated</dt>
							<dd><time datetime={updated.toISOString()}>{isoDate(updated)}</time></dd>
						</div>
					)
				}
				{
					position && (
						<div>
							<dt>Die</dt>
							<dd class="position">{position}</dd>
						</div>
					)
				}
				{
					tags.length > 0 && (
						<div>
							<dt>Tags</dt>
							<dd>{tags.join(', ')}</dd>
						</div>
					)
				}
			</dl>
		</header>
		<div class="prose">
			<slot />
		</div>
	</article>
</BaseLayout>

<style>
	.cover {
		max-width: calc(var(--measure) + 12rem);
		margin: 0 0 var(--space-4);
		border: 1px solid var(--rule);
		border-top: 3px solid var(--accent);
	}
	.cover img {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 1200 / 630;
		object-fit: cover;
	}
	@media (min-width: 68rem) {
		.cover {
			margin-left: var(--gutter-left);
		}
	}

	.article-header {
		max-width: var(--measure);
		border-top: 3px solid var(--accent);
		padding-top: var(--space-3);
		margin-bottom: var(--space-5);
		padding-bottom: var(--space-4);
		border-bottom: 1px solid var(--rule);
	}
	/* The cover already carries the accent rule. */
	.article-header.has-cover {
		border-top: 0;
		padding-top: 0;
	}
	@media (min-width: 68rem) {
		.article-header {
			margin-left: var(--gutter-left);
		}
	}
	.lede {
		font-size: var(--text-lg);
		color: var(--muted);
	}
	.meta {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-1) var(--space-4);
		margin: 0;
		font-size: var(--text-sm);
	}
	.meta div {
		display: flex;
		gap: var(--space-2);
	}
	.meta dt {
		color: var(--muted);
	}
	.meta dd {
		margin: 0;
	}
	.position {
		color: var(--accent);
	}
	.draft {
		font-size: var(--text-sm);
		color: var(--accent);
	}
</style>
