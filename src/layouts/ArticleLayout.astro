---
import BaseLayout from './BaseLayout.astro';
import { isoDate } from '../lib/content';

interface Props {
	title: string;
	description: string;
	date: Date;
	updated?: Date;
	tags: string[];
	lang: 'en' | 'es';
	draft: boolean;
}

const { title, description, date, updated, tags, lang, draft } = Astro.props;
---

<BaseLayout title={title} description={description} lang={lang} ogType="article">
	<article>
		<header class="article-header">
			{draft && <p class="draft mono">DRAFT — not in production build</p>}
			<h1>{title}</h1>
			<p class="lede">{description}</p>
			<dl class="meta mono">
				<div>
					<dt>Published</dt>
					<dd><time datetime={date.toISOString()}>{isoDate(date)}</time></dd>
				</div>
				{
					updated && (
						<div>
							<dt>Updated</dt>
							<dd><time datetime={updated.toISOString()}>{isoDate(updated)}</time></dd>
						</div>
					)
				}
				{
					tags.length > 0 && (
						<div>
							<dt>Tags</dt>
							<dd>{tags.join(', ')}</dd>
						</div>
					)
				}
			</dl>
		</header>
		<div class="prose">
			<slot />
		</div>
	</article>
</BaseLayout>

<style>
	.article-header {
		max-width: var(--measure);
		margin-bottom: var(--space-5);
		padding-bottom: var(--space-4);
		border-bottom: 1px solid var(--rule);
	}
	@media (min-width: 68rem) {
		.article-header {
			margin-left: var(--gutter-left);
		}
	}
	.lede {
		font-size: var(--text-lg);
		color: var(--muted);
	}
	.meta {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-1) var(--space-4);
		margin: 0;
		font-size: var(--text-sm);
	}
	.meta div {
		display: flex;
		gap: var(--space-2);
	}
	.meta dt {
		color: var(--muted);
	}
	.meta dd {
		margin: 0;
	}
	.draft {
		font-size: var(--text-sm);
		color: var(--accent);
	}
</style>
