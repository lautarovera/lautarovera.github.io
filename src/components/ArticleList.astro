---
import { isoDate, type ListItem } from '../lib/content';

interface Props {
	items: ListItem[];
}

const { items } = Astro.props;
---

{
	items.length === 0 ? (
		<p class="muted">Nothing published yet.</p>
	) : (
		<ol class="article-list">
			{items.map(({ href, data }) => (
				<li class:list={[`block-${data.block}`]}>
					<a class="thumb" href={href} tabindex="-1" aria-hidden="true">
						{data.cover && <img src={data.cover.src} alt="" loading="lazy" decoding="async" />}
					</a>
					<div class="text">
						<p class="meta mono">
							<time datetime={data.date.toISOString()}>{isoDate(data.date)}</time>
							<span class="block-tag">{data.block}</span>
							{data.draft && <span class="draft">draft</span>}
						</p>
						<h3>
							<a href={href}>{data.title}</a>
						</h3>
						<p class="description">{data.description}</p>
					</div>
				</li>
			))}
		</ol>
	)
}

<style>
	.article-list {
		list-style: none;
		padding: 0;
		margin: 0;
		max-width: calc(var(--measure) + 12rem);
	}

	li {
		display: grid;
		grid-template-columns: 11rem 1fr;
		gap: var(--space-4);
		padding: var(--space-4) 0;
		border-bottom: 1px solid var(--rule);
	}
	.block-edge-ai {
		--block: var(--block-edge-ai);
	}
	.block-firmware {
		--block: var(--block-firmware);
	}
	.block-hardware {
		--block: var(--block-hardware);
	}

	.thumb {
		display: block;
		aspect-ratio: 1200 / 630;
		background: var(--die-substrate);
		border: 1px solid var(--rule);
		overflow: hidden;
	}
	.thumb img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.meta {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-1) var(--space-3);
		margin: 0;
		font-size: var(--text-sm);
		color: var(--muted);
	}
	.block-tag {
		color: var(--block);
	}
	.draft {
		color: var(--fg);
	}

	h3 {
		margin: var(--space-1) 0 0;
		font-size: var(--text-lg);
	}
	h3 a {
		color: var(--fg);
		text-decoration: none;
		background-image: linear-gradient(var(--block), var(--block));
		background-size: 0% 2px;
		background-repeat: no-repeat;
		background-position: 0 100%;
	}
	.description {
		margin: var(--space-1) 0 0;
		color: var(--muted);
	}

	/* The whole row responds to hover or keyboard focus. */
	li:hover .thumb,
	li:focus-within .thumb {
		border-color: var(--block);
	}
	li:hover h3 a,
	li:focus-within h3 a {
		background-size: 100% 2px;
	}

	@media (prefers-reduced-motion: no-preference) {
		h3 a {
			transition: background-size 180ms ease-out;
		}
		.thumb {
			transition: border-color 180ms ease-out;
		}
	}

	@media (max-width: 34rem) {
		li {
			grid-template-columns: 1fr;
			gap: var(--space-2);
		}
		.thumb {
			max-width: 14rem;
		}
	}
</style>
