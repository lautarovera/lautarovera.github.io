---
import { render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { diePosition, getPublished } from '../../lib/content';

export async function getStaticPaths() {
	const posts = await getPublished('blog');
	return posts.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const position = await diePosition(`/blog/${entry.id}/`);
---

<ArticleLayout {...entry.data} position={position}>
	<Content />
</ArticleLayout>
