---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleList from '../../components/ArticleList.astro';
import { getPublished, toListItems } from '../../lib/content';

const projects = await getPublished('projects');
---

<BaseLayout
	title="Projects"
	description="Technical case studies: problem, decisions, validation on hardware, results."
>
	<h1>Projects</h1>
	<ArticleList items={toListItems(projects, "/projects/")} />
</BaseLayout>
