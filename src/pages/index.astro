---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleList from '../components/ArticleList.astro';
import Floorplan from '../components/Floorplan.astro';
import { getPublished, toCells } from '../lib/content';

const projects = await getPublished('projects');
const posts = await getPublished('blog');
const cells = toCells(projects, posts);
---

<BaseLayout>
	<h1>Lautaro Vera</h1>
	<p class="intro">Senior embedded firmware engineer. Firmware, hardware and Edge AI.</p>

	<Floorplan cells={cells} />

	<h2>Projects</h2>
	<ArticleList entries={projects} basePath="/projects/" />

	<h2>Writing</h2>
	<ArticleList entries={posts} basePath="/blog/" />
</BaseLayout>

<style>
	.intro {
		font-size: var(--text-lg);
		color: var(--muted);
		max-width: var(--measure);
	}
</style>
